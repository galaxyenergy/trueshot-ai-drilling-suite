{
    "customer_name": "TRUEshot",
    "project_prefix": "TRS",

    "auto_create_project": true,
    "auto_create_run": true,
    "auto_create_shift": true,

    "archive_imports": true,
    "generate_reports": true,

    "enable_live_connection": false,
    "enable_periodic_import": true,

    "default_import_mode": "Periodic Data Synchronization",

    "default_shift_times": {
        "day": "06:00",
        "night": "18:00"
    },

    "survey_management": true,
    "tool_dump_management": true,
    "multi_operator": true,
    "multi_rig": true
}